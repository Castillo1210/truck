# Copia este archivo a ".env.local" y ajusta la URL según dónde corra el backend.
# Vite solo expone al cliente las variables que empiezan con VITE_.

# URL base de la API (incluye el prefijo de versión /api/v1).
# El puerto por defecto en desarrollo es el del perfil "http" de
# CaraNegra.API/Properties/launchSettings.json (5014). Si corres el
# perfil "https", usa https://localhost:7108/api/v1 en su lugar.
VITE_API_URL=http://localhost:5014/api/v1
