# Copiar este archivo a ".env" (que NO se debe subir a git) y completar con
# valores reales antes de "docker compose up". Ver CONFIGURACION_LOCAL.md,
# sección "Fase 6 — Despliegue".

# --- Base de datos ---
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_DATABASE=caranegra
MYSQL_USER=caranegra
MYSQL_PASSWORD=cambia-esta-clave

# --- Backend ---
# Genera un secreto largo y aleatorio, ej.: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
# Dominio/URL pública desde donde el navegador accede al frontend (para CORS).
FRONTEND_URL=http://localhost:8081

# --- Impresora de cocina (Fase 6, opcional) ---
IMPRESORA_HABILITADA=false
IMPRESORA_IP=
IMPRESORA_PUERTO=9100

# --- Frontend ---
# URL pública desde la que el NAVEGADOR del cliente alcanza la API.
VITE_API_URL=http://localhost:8080/api/v1
